# Neon/PostgreSQL connection string. Use a secret supplied by the hosting provider.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Generate a long, random secret (at least 32 characters) for every environment.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Hosting providers normally inject PORT. CORS_ORIGIN accepts comma-separated origins.
PORT=3333
CORS_ORIGIN=http://localhost:5173

# Optional for the first production release. Configure all three to enable Google OAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
