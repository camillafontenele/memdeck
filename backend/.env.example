# Neon/PostgreSQL connection string. Use a secret supplied by the hosting provider.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Generate a long, random secret (at least 32 characters) for every environment.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Hosting providers normally inject PORT. CORS_ORIGIN accepts comma-separated origins.
PORT=3333
CORS_ORIGIN=http://localhost:5173

# Optional: leave ALL four empty to disable Google OAuth. Configure all four to enable it.
# Local example: GOOGLE_REDIRECT_URI=http://localhost:3333/auth/google/callback
# Local example: FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
FRONTEND_URL=

# Production: NODE_ENV=production (Secure, host-only OAuth cookies).
# Only trusted proxy IPs/CIDRs, comma-separated; empty means no proxy trust.
# Never use an unrestricted value or trust arbitrary X-Forwarded-For headers.
TRUSTED_PROXIES=
